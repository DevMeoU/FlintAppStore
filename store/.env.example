# Local gateway: http://127.0.0.1:3300
PORT=3300
USER_SERVICE_PORT=3301
APP_SERVICE_PORT=3302
ORDER_SERVICE_PORT=3303
PAYMENT_MODE=demo
# NODE_ENV=production requires the 3 values below.
# Public test deployment only: DEPLOYMENT_MODE=demo permits mock payments.
# HOST=0.0.0.0 for Render; internal services always stay on loopback.
# REQUIRE_TURSO=true prevents database loss from ephemeral local fallback.
# JWT_SECRET=replace-with-a-long-random-secret
# INTERNAL_SERVICE_SECRET=replace-with-a-different-long-random-secret
# ADMIN_PASSWORD=replace-before-first-production-start
# DATA_DIR=D:/FlintStoreData
# Optional remote databases; tests always use isolated local databases.
# TURSO_USER_SERVICE_URL=libsql://...
# TURSO_APP_SERVICE_URL=libsql://...
# TURSO_ORDER_SERVICE_URL=libsql://...
# TURSO_TOKEN=...
